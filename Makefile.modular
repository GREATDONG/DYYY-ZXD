#
#  DYYY
#
#  Copyright (c) 2024 huami. All rights reserved.
#  Channel: @huamidev
#  Created on: 2024/10/04
#  优化: v2.0 模块化重构
#
#  支持的模块:
#  - DYYYVideoHooks.xm    视频相关 Hooks
#  - DYYYCommentHooks.xm   评论相关 Hooks
#  - DYYYLiveHooks.xm     直播相关 Hooks
#  - DYYYUIHooks.xm       界面相关 Hooks
#  - DYYYSwiftHooksSafe.m Swift Hook 安全模式
#

-include Makefile.local

TARGET = iphone:clang:latest:14.0
ARCHS = arm64 arm64e

ifeq ($(SCHEME),roothide)
    export THEOS_PACKAGE_SCHEME = roothide
else ifeq ($(SCHEME),rootless)
    export THEOS_PACKAGE_SCHEME = rootless
else
    unexport THEOS_PACKAGE_SCHEME
endif

ifeq ($(GITHUB_ACTIONS),true)
    export INSTALL = 0
    export FINALPACKAGE = 1
endif

export DEBUG = 0
INSTALL_TARGET_PROCESSES = Aweme

include $(THEOS)/makefiles/common.mk

TWEAK_NAME = DYYY

# ========================================
# 模块化源文件列表
# ========================================

# 核心 Hooks 模块（按功能拆分）
DYYY_FILES = \
    DYYYVideoHooks.xm \
    DYYYCommentHooks.xm \
    DYYYLiveHooks.xm \
    DYYYUIHooks.xm

# Swift Hook 安全模式管理器
DYYY_FILES += \
    DYYYSwiftHookManager.m \
    DYYYSwiftHooksSafe.m

# UI 组件
DYYY_FILES += \
    DYYYFloatClearButton.xm \
    DYYYFloatSpeedButton.m \
    DYYYSettings.xm \
    DYYYABTestHook.xm \
    DYYYLongPressPanel.xm \
    DYYYSettingsHelper.m \
    DYYYImagePickerDelegate.m \
    DYYYBackupPickerDelegate.m \
    DYYYSettingViewController.m \
    DYYYBottomAlertView.m \
    DYYYCustomInputView.m \
    DYYYOptionsSelectionView.m \
    DYYYIconOptionsDialogView.m \
    DYYYAboutDialogView.m \
    DYYYKeywordListView.m \
    DYYYFilterSettingsView.m \
    DYYYConfirmCloseView.m

# 核心功能
DYYY_FILES += \
    DYYYToast.m \
    DYYYManager.m \
    DYYYUtils.m

# 工具类
DYYY_FILES += \
    CityManager.m \
    AWMSafeDispatchTimer.m

# ========================================
# 编译选项
# ========================================

DYYY_CFLAGS = -fobjc-arc -w -Wno-deprecated-declarations -Wno-unused-variable

DYYY_LDFLAGS = -weak_framework AVFAudio -weak_framework Photos

DYYY_FRAMEWORKS = CoreAudio CoreGraphics UIKit Foundation

CXXFLAGS += -std=c++17
CCFLAGS += -std=c++17

# ========================================
# Logos 配置
# ========================================

DYYY_LOGOS_DEFAULT_GENERATOR = internal

export THEOS_STRICT_LOGOS=0
export ERROR_ON_WARNINGS=0
export LOGOS_DEFAULT_GENERATOR=internal

# ========================================
# 构建包含
# ========================================

include $(THEOS_MAKE_PATH)/tweak.mk

# ========================================
# 设备配置
# ========================================

ifeq ($(shell whoami),huami)
    THEOS_DEVICE_IP = 192.168.31.222
else
    THEOS_DEVICE_IP = 192.168.15.201
endif
THEOS_DEVICE_PORT = 22

# ========================================
# 构建提示和自动安装
# ========================================

before-package::
	@echo -e "\033[34m==>\033[0m 正在构建 DYYY 插件 v2.0 (模块化)..."
	@echo -e "\033[34m==>\033[0m 模块列表:"
	@echo -e "\033[34m   - DYYYVideoHooks.xm\033[0m    视频相关 Hooks"
	@echo -e "\033[34m   - DYYYCommentHooks.xm\033[0m   评论相关 Hooks"
	@echo -e "\033[34m   - DYYYLiveHooks.xm\033[0m     直播相关 Hooks"
	@echo -e "\033[34m   - DYYYUIHooks.xm\033[0m       界面相关 Hooks"
	@echo -e "\033[34m   - DYYYSwiftHookManager\033[0m Swift Hook 安全模式"
	@echo ""

clean::
	@echo -e "\033[31m==>\033[0m Cleaning packages…"
	@rm -rf .theos packages

after-package::
	@echo -e "\033[32m==>\033[0m 构建完成!"
	@echo -e "\033[32m==>\033[0m 已生成模块化 DYYY 插件"
	@if [ "$(GITHUB_ACTIONS)" != "true" ] && [ "$(INSTALL)" = "1" ]; then \
        DEB_FILE=$$(ls -t packages/*.deb | head -1); \
        PACKAGE_NAME=$$(basename "$$DEB_FILE" | cut -d'_' -f1); \
        echo -e "\033[34m==>\033[0m 正在安装到设备…"; \
        ssh root@$(THEOS_DEVICE_IP) "rm -rf /tmp/$${PACKAGE_NAME}.deb"; \
        scp "$$DEB_FILE" root@$(THEOS_DEVICE_IP):/tmp/$${PACKAGE_NAME}.deb; \
        ssh root@$(THEOS_DEVICE_IP) "dpkg -i --force-overwrite /tmp/$${PACKAGE_NAME}.deb && rm -f /tmp/$${PACKAGE_NAME}.deb"; \
	else \
        echo -e "\033[33m==>\033[0m 跳过安装 (GitHub Actions 或 INSTALL!=1)"; \
	fi

# ========================================
# 便捷目标
# ========================================

.PHONY: modules clean reinstall

modules:
	@echo "DYYY 模块化结构:"
	@echo "  DYYYVideoHooks.xm     - 视频相关 Hooks"
	@echo "  DYYYCommentHooks.xm   - 评论相关 Hooks"
	@echo "  DYYYLiveHooks.xm      - 直播相关 Hooks"
	@echo "  DYYYUIHooks.xm        - 界面相关 Hooks"
	@echo "  DYYYSwiftHookManager  - Swift Hook 安全模式管理器"
	@echo "  DYYYSwiftHooksSafe    - Swift Hook 安全模式实现"
	@echo ""
	@echo "其他组件:"
	@echo "  DYYYFloatClearButton  - 浮动清除按钮"
	@echo "  DYYYFloatSpeedButton  - 浮动速度按钮"
	@echo "  DYYYSettings          - 设置页面"
	@echo "  DYYYManager           - 核心管理器"
	@echo "  DYYYUtils             - 工具类"

reinstall: package
	@DEB_FILE=$$(ls -t packages/*.deb | head -1); \
    PACKAGE_NAME=$$(basename "$$DEB_FILE" | cut -d'_' -f1); \
    echo -e "\033[34m==>\033[0m 正在安装到设备…"; \
    ssh root@$(THEOS_DEVICE_IP) "rm -rf /tmp/$${PACKAGE_NAME}.deb"; \
    scp "$$DEB_FILE" root@$(THEOS_DEVICE_IP):/tmp/$${PACKAGE_NAME}.deb"; \
    ssh root@$(THEOS_DEVICE_IP) "dpkg -i --force-overwrite /tmp/$${PACKAGE_NAME}.deb && rm -f /tmp/$${PACKAGE_NAME}.deb"
